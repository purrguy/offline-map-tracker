<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.osmdroid.views.MapView
        android:id="@+id/mapview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">
        <Button android:id="@+id/btn_my_location" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="◎ Location" />
        <Button android:id="@+id/btn_toggle_offline" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Offline: Auto" />
    </LinearLayout>
    <TextView android:id="@+id/tv_map_status"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="#CC000000" android:textColor="#FFFFFF"
        android:padding="6dp" android:text="Tap+hold to set destination" />
</FrameLayout>
